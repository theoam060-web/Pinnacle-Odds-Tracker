modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
POLL_INTERVAL_MS = "20000"
MIN_DROP_PERCENT = "0.5"
PINNACLE_SPORT_NAMES = "soccer,basketball,tennis,hockey,football,baseball,handball,volleyball"
PINNACLE_MARKET_TYPES = "moneyline,spread,total"
VAPID_EMAIL = "mailto:alerts@sharptracker.io"
PINNACLE_SPORT_IDS = "4,19,33,29,15,3"
MOCK_MODE = "true"
VITE_ADMIN_EMAILS = "theoam060@gmail.com"

[userenv.development]
GOOGLE_CALLBACK_URL = "https://84e61830-7611-4d35-8623-77d057b02e4e-00-30ovvqhxka0d5.kirk.replit.dev/api/auth/google/callback"

[userenv.production]
GOOGLE_CALLBACK_URL = "https://sharptracker.io/api/auth/google/callback"

[nix]
channel = "stable-25_05"
